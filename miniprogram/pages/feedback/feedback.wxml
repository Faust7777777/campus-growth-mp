<view class="page">
  <view class="hero">
    <view class="hero-title">记录核销反馈</view>
    <view class="hero-sub">销售额由核销码自动核算，非手工估算</view>
  </view>

  <!-- C3：核销码 -->
  <view class="card vcode-card" wx:if="{{verifyCode}}">
    <view class="vcode-line">
      <text class="vcode-k">本活动核销码</text>
      <text class="vcode-v">{{verifyCode}}</text>
    </view>
    <view class="muted">学生报码核销，下方按「核销数 × 活动价 ¥{{price}}」自动算销售额</view>
  </view>

  <view class="card" wx:if="{{form}}">
    <view class="field">
      <view class="field-label">核销码核销数<text class="req">*</text></view>
      <input class="input" type="digit" value="{{form.redeemCount}}" data-key="redeemCount" bindinput="onInput" placeholder="如：23" />
    </view>
    <view class="field">
      <view class="field-label">估算销售额（自动）</view>
      <view class="auto-sales">¥{{estSales}} <text class="auto-sales-formula">= {{form.redeemCount}} 单 × ¥{{price}}</text></view>
    </view>
    <view class="field">
      <view class="field-label">顾客反馈</view>
      <textarea class="textarea" value="{{form.customerFeedback}}" data-key="customerFeedback" bindinput="onInput" placeholder="顾客的真实评价" />
    </view>
    <view class="field">
      <view class="field-label">老板评价</view>
      <textarea class="textarea" value="{{form.ownerNote}}" data-key="ownerNote" bindinput="onInput" placeholder="你自己的观察，如利润、出餐压力" />
    </view>
  </view>

  <view class="footbar">
    <button class="btn btn-primary" loading="{{submitting}}" bindtap="submit">生成复盘报告</button>
  </view>
</view>
