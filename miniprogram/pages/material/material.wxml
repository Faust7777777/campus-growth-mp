<view class="page" wx:if="{{c}}">
  <view class="hero">
    <view class="hero-title">{{c.name}}</view>
    <view class="hero-sub">{{c.scene}}</view>
  </view>

  <!-- 活动详情 -->
  <view class="card">
    <view class="card-title"><view class="dot"></view>活动详情</view>
    <view class="row-line"><text class="row-k">推荐套餐</text><text class="row-v">{{c.comboName}}</text></view>
    <view class="row-line"><text class="row-k">价格建议</text><text class="row-v">{{c.priceSuggestion}}</text></view>
    <view class="row-line"><text class="row-k">优惠口令</text><text class="row-v">{{c.token}}</text></view>
    <view class="row-line"><text class="row-k">发布时间</text><text class="row-v">{{c.publishTime}}</text></view>
    <view class="combo-tags">
      <view wx:for="{{c.comboItems}}" wx:key="*this" class="tag">{{item}}</view>
    </view>
    <view class="camp-risk">⚠ {{c.risk}}</view>
  </view>

  <!-- C1：毛利护栏（去风险化）-->
  <view class="card" wx:if="{{c.margin}}">
    <view class="card-title"><view class="dot"></view>毛利护栏（系统自动核算）</view>
    <view class="margin-grid">
      <view class="margin-cell"><view class="margin-num">¥{{c.comboPrice}}</view><view class="margin-label">活动价</view></view>
      <view class="margin-cell"><view class="margin-num">¥{{c.margin.comboCost}}</view><view class="margin-label">套餐成本</view></view>
      <view class="margin-cell"><view class="margin-num ok">¥{{c.margin.grossMargin}}</view><view class="margin-label">单份毛利</view></view>
      <view class="margin-cell"><view class="margin-num ok">{{c.margin.marginRate}}%</view><view class="margin-label">毛利率</view></view>
    </view>
    <view class="margin-badge {{c.margin.blocked ? 'warn' : 'ok'}}">{{c.margin.status}}</view>
  </view>

  <!-- C3：核销码（可识别归因）-->
  <view class="card" wx:if="{{c.verifyCode}}">
    <view class="card-title"><view class="dot"></view>核销码</view>
    <view class="vcode-row">
      <view class="vcode">{{c.verifyCode}}</view>
      <view class="vcode-tip">学生报此码核销，销售额由「核销数 × 活动价」自动计算，归因可识别</view>
    </view>
  </view>

  <!-- 内容物料 -->
  <view class="section-title"><view class="dot"></view>内容物料（可一键复制）</view>
  <view wx:for="{{copyBlocks}}" wx:key="key" class="card copy-card">
    <view class="copy-head">
      <text class="copy-label">{{item.label}}</text>
      <view class="copy-btn" data-text="{{item.text}}" bindtap="copyText">复制文案</view>
    </view>
    <view class="copy-text">{{item.text}}</view>
  </view>

  <view class="footbar">
    <button class="btn btn-primary" bindtap="goFeedback">去记录核销</button>
  </view>
</view>
