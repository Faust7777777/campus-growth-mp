/* ===== 全局设计系统 ===== */
page {
  --brand: #FF6B35;
  --brand-deep: #E8551E;
  --brand-soft: #FFF1EA;
  --ink: #1F2329;
  --ink-2: #4E5969;
  --ink-3: #86909C;
  --line: #EEF0F3;
  --bg: #F5F6F8;
  --ok: #00B42A;
  --warn: #FF7D00;
  --danger: #F53F3F;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button { box-sizing: border-box; }

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
}

/* 顶部渐变头 */
.hero {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 53, 0.28);
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.92; margin-top: 8rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; display: flex; align-items: center; }
.card-title .dot { width: 8rpx; height: 30rpx; background: var(--brand); border-radius: 6rpx; margin-right: 14rpx; }

/* 章节标题 */
.section-title { font-size: 30rpx; font-weight: 700; margin: 8rpx 0 18rpx; display: flex; align-items: center; }
.section-title .dot { width: 8rpx; height: 30rpx; background: var(--brand); border-radius: 6rpx; margin-right: 14rpx; }

/* 表单 */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--ink-2); margin-bottom: 12rpx; }
.field-label .req { color: var(--danger); margin-left: 6rpx; }
.input, .textarea {
  width: 100%;
  background: #F7F8FA;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.textarea { min-height: 140rpx; }

/* 按钮 */
.btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 600;
  padding: 24rpx 0;
  line-height: 1.4;
  border: none;
}
.btn::after { border: none; }
.btn-primary { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%); color: #fff; box-shadow: 0 10rpx 22rpx rgba(255,107,53,0.32); }
.btn-ghost { background: #fff; color: var(--brand); border: 2rpx solid var(--brand); }
.btn-plain { background: #F2F3F5; color: var(--ink-2); }
.btn[disabled] { opacity: 0.55; }

/* 底部固定操作条 */
.footbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  border-top: 2rpx solid var(--line);
  display: flex; gap: 20rpx;
}
.footbar .btn { flex: 1; }

/* 标签 / chips */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  background: #F2F3F5; color: var(--ink-2); font-size: 27rpx;
}
.chip.active { background: var(--brand-soft); color: var(--brand-deep); border: 2rpx solid var(--brand); font-weight: 600; }
.tag { display: inline-block; padding: 6rpx 16rpx; border-radius: 8rpx; background: var(--brand-soft); color: var(--brand-deep); font-size: 22rpx; margin: 0 10rpx 10rpx 0; }
.tag.gray { background: #F2F3F5; color: var(--ink-3); }

/* 数字卡片网格 */
.stat-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.stat {
  flex: 1; min-width: 30%;
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31,35,41,0.05);
}
.stat-num { font-size: 46rpx; font-weight: 800; color: var(--brand-deep); }
.stat-label { font-size: 24rpx; color: var(--ink-3); margin-top: 6rpx; }

/* 条形图 */
.bar-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.bar-name { width: 200rpx; font-size: 26rpx; color: var(--ink-2); }
.bar-track { flex: 1; height: 22rpx; background: #F0F1F3; border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #FF9A6B, var(--brand)); border-radius: 999rpx; }
.bar-val { width: 70rpx; text-align: right; font-size: 24rpx; color: var(--ink-3); }

/* 文本块 */
.muted { color: var(--ink-3); font-size: 25rpx; }
.row-line { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.row-line:last-child { border-bottom: none; }
.row-k { color: var(--ink-3); }
.row-v { color: var(--ink); font-weight: 600; text-align: right; max-width: 60%; }

/* 加载 */
.loading-wrap { padding: 80rpx 0; text-align: center; color: var(--ink-3); }
.spinner {
  width: 64rpx; height: 64rpx; margin: 0 auto 24rpx;
  border: 6rpx solid var(--brand-soft); border-top-color: var(--brand);
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 提示条 */
.notice {
  background: #FFF7E8; color: #A35200; border: 2rpx solid #FFE4B8;
  border-radius: 16rpx; padding: 18rpx 24rpx; font-size: 25rpx; margin-bottom: 20rpx;
}
.notice.empty { background: #F2F3F5; color: var(--ink-3); border-color: var(--line); }
